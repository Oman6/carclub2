{
  "name": "bryant-car-show",
  "private": true,
  "description": "Bryant University Car Show 2027 website",
  "scripts": {
    "build": "npm run build:css && npm run build:js && node tools/stamp.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o styles.css --minify",
    "build:js": "esbuild src/app.jsx --bundle --outfile=app.js --format=iife --target=es2018 --minify --legal-comments=none --define:process.env.NODE_ENV=\\\"production\\\""
  },
  "dependencies": {
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "tailwindcss": "3.4.17"
  }
}
